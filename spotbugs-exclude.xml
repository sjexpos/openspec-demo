<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <Match>
        <Package name="~com\.example\.demo\.domain\.models.*"/>
        <Method name="~.*\$\$_hibernate_.*" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <Match>
        <Package name="~com\.example\.demo\.domain\.models.*"/>
        <Method name="~.*\$\$_hibernate_.*" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>

    <Match>
        <Class name="~.*\$[A-Za-z0-9_]*Builder" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>

    <Match>
        <Package name="~com\.example\.demo\.presentation\.api.*"/>
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <Match>
        <Package name="~com\.example\.demo\.presentation\.api.*"/>
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>

    <Match>
        <Package name="~com\.example\.demo\.presentation\.controllers.*"/>
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>

    <Match>
        <Package name="~com\.example\.demo\.application\.services.*"/>
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>

    <Match>
        <Package name="~com\.example\.demo\.infrastructure\.adapters\.storage.*"/>
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>

    <!-- KAN-16: Spring constructor injection of collaborator beans (SqsProperties,
         ObservationRegistry) inherently stores external references; same pattern as
         services/controllers/storage above. -->
    <Match>
        <Package name="~com\.example\.demo\.infrastructure\.config.*"/>
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>

</FindBugsFilter>
